<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.sim</groupId>
        <artifactId>vexelray-sim-fluid</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-sim-fluid-gui</artifactId>

    <description>
        The simulation on the VexelRay stack: a runner that steps a patch on resident buffers and keeps its
        clock, and a debug view that shows what the state holds and makes an unhealthy one obvious. Everything
        Vulkan-aware lives here and nowhere below it.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.sim</groupId>
            <artifactId>vexelray-sim-fluid-core</artifactId>
        </dependency>
        <!-- The work budget and the orbit camera, and for the demo above, Builds, Dial and Pick. -->
        <dependency>
            <groupId>dev.vexelray.sim</groupId>
            <artifactId>vexelray-sim-core-gui</artifactId>
        </dependency>
        <!-- Accelerator, resident buffers, and the fullscreen vertex stage the view draws with. The simulation
             computes on the device the application draws on (GuiApp.gpu()), so a picture of its state reads the
             buffers the kernels wrote rather than a copy; without a window it opens a device of its own. -->
        <dependency>
            <groupId>dev.supirvast</groupId>
            <artifactId>vastir-tools</artifactId>
        </dependency>
        <!-- The march the 3D view is built on, over a distance field that reads the simulation's grid. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-technique-sdf</artifactId>
        </dependency>
        <!-- The window's side: the node the view is shown in, and GuiApp, which mints its target and buffer. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-vulkan</artifactId>
        </dependency>
    </dependencies>
</project>
