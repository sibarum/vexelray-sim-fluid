<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.sim</groupId>
        <artifactId>vexelray-sim-fluid</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-sim-fluid-demo</artifactId>

    <description>
        The experiments, on screen. A framework application shaped like the project builder's template: one
        window, a debug view of a patch, the readings beside it, and the scenarios on keys. Driveable through
        the automation socket under --automation, so screenshots are taken of the live window.
    </description>

    <properties>
        <app.mainClass>dev.vexelray.sim.fluid.demo.FluidDemo</app.mainClass>
        <!-- Program arguments for exec:exec, split on whitespace. Empty is the interactive run. -->
        <app.args></app.args>
        <!-- The automation driver: "off", "on" for the default port, or a port number; 0 is a free one. -->
        <automation>off</automation>
        <app.jvmArgs></app.jvmArgs>
        <!--
          Two editions of the same code. The debug edition links the automation socket; the release edition does not
          contain it at all: -Pnative-release swaps the source root below for src/edition-release (an Edition with no
          driver) and gives the automation modules scope test, so they are on no runtime classpath. Everything but
          -Pnative-release - tests, exec:exec, -Pnative - is the debug edition.
        -->
        <edition.src>src/edition-debug/java</edition.src>
        <automation.scope>compile</automation.scope>
        <!-- The debug edition is a console program, so ottermate can read the port it prints. -->
        <native.imageName>vexelray-sim-fluid-demo</native.imageName>
        <native.subsystem>CONSOLE</native.subsystem>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.sim</groupId>
            <artifactId>vexelray-sim-fluid-gui</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.kronometer</groupId>
            <artifactId>kronometer-core</artifactId>
        </dependency>
        <!-- The application edge: input, clipboard, window memory, clock, frame loop, shutdown. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-shell</artifactId>
            <version>${vexelray.framework.version}</version>
        </dependency>
        <!-- The driving socket, off unless asked for; in the debug edition only. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-automation</artifactId>
            <version>${vexelray.framework.version}</version>
            <scope>${automation.scope}</scope>
        </dependency>
        <!-- The title bar, which the framework hands over and this application places. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>${vexelray.gui.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
            <version>${vexelray.gui.version}</version>
            <scope>${automation.scope}</scope>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  GraalVM native image, shared by -Pnative and -Pnative-release, which differ only in the image's
                  name, its subsystem and which edition is compiled. The reachability metadata (FFM downcalls and
                  upcalls, reflection, resources) is under src/main/resources/META-INF/native-image/; see the README
                  for how to record it again.
                -->
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>0.10.6</version>
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <id>build-native</id>
                            <goals><goal>compile-no-fork</goal></goals>
                            <phase>package</phase>
                        </execution>
                    </executions>
                    <configuration>
                        <imageName>${native.imageName}</imageName>
                        <mainClass>${app.mainClass}</mainClass>
                        <buildArgs>
                            <!-- The FFM flags, the shaders and the font atlas come from the libraries' own
                                 META-INF/native-image metadata. -->
                            <buildArg>--no-fallback</buildArg>
                            <buildArg>-Dstdout.encoding=UTF-8</buildArg>
                            <!-- WINDOWS = no console window, and /ENTRY:mainCRTStartup is not optional alongside it:
                                 the linker would otherwise look for WinMain, and the image's entry is the C main.
                                 CONSOLE is the linker's default, spelled out so both editions pass the same
                                 options. Windows linker options. -->
                            <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:${native.subsystem}</buildArg>
                            <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>
                        </buildArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- The edition's own source (Edition): src/edition-debug, or src/edition-release under -Pnative-release. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-edition-source</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${edition.src}</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The framework's annotation processor: it generates FluidDemoWiring from Recipes and Physics,
                         and what its vocabulary calls a compile error is one. Named rather than found, because since
                         JDK 23 javac runs no processor it merely finds on the class path. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>dev.vexelray.framework</groupId>
                            <artifactId>vexelray-framework-processor</artifactId>
                            <version>${vexelray.framework.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!-- Run in a fresh JVM, so native access can be enabled for Panama:  mvn exec:exec
                 One command line split on whitespace, as the template does it, so a multi-word app.args is
                 several arguments. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <commandlineArgs>--enable-native-access=ALL-UNNAMED -Dstdout.encoding=UTF-8 -Dautomation=${automation} ${app.jvmArgs} -classpath %classpath ${app.mainClass} ${app.args}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          GraalVM native images, profile-gated as vexelray-gui-demo's are: native-image takes a minute and needs a
          GraalVM JDK, and an ordinary package must not pay for it.

          mvn -Pnative-release -pl vexelray-sim-fluid-demo -am package  ->  target/fluid-sim.exe
              what ships: a GUI subsystem program with no automation module; installer.json points at it.
          mvn -Pnative -pl vexelray-sim-fluid-demo -am package          ->  target/vexelray-sim-fluid-demo.exe
              the debug edition: a console program that ottermate can drive with its automation flag.
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-release</id>
            <properties>
                <edition.src>src/edition-release/java</edition.src>
                <automation.scope>test</automation.scope>
                <native.imageName>fluid-sim</native.imageName>
                <native.subsystem>WINDOWS</native.subsystem>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Exactly one activates from the host OS: VexelRay's provider and tactroller's input backend. -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <!-- Windows present through DXGI, the default: a window resize is the OS's buffer resize, not a new
                     Vulkan swapchain. -Dvexelray.present=vulkan asks for the swapchain instead. -->
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-present-dxgi</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-macos</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
