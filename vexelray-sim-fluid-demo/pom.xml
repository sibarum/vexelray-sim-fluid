<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.sim</groupId>
        <artifactId>vexelray-sim-fluid</artifactId>
        <version>0.1.3-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-sim-fluid-demo</artifactId>

    <description>
        The experiments, on screen. A framework application shaped like the project builder's template: one
        window, a debug view of a patch, the readings beside it, and the scenarios on keys. Driveable through
        the automation socket under --automation, so screenshots are taken of the live window.
    </description>

    <properties>
        <app.mainClass>dev.vexelray.sim.fluid.demo.FluidDemo</app.mainClass>
        <!-- Program arguments for exec:exec, split on whitespace. Empty is the interactive run. -->
        <app.args></app.args>
        <!-- The automation driver: "off", "on" for the default port, or a port number; 0 is a free one. -->
        <automation>off</automation>
        <app.jvmArgs></app.jvmArgs>
        <!-- The debug build is a console program, so ottermate can read the port it prints. -->
        <native.imageName>vexelray-sim-fluid-demo</native.imageName>
        <native.subsystem>CONSOLE</native.subsystem>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.sim</groupId>
            <artifactId>vexelray-sim-fluid-gui</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.kronometer</groupId>
            <artifactId>kronometer-core</artifactId>
        </dependency>
        <!-- The application edge: input, clipboard, window memory, clock, frame loop, shutdown. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-shell</artifactId>
            <version>${vexelray.framework.version}</version>
        </dependency>
        <!-- The automation sockets, remote control and diagnostics: in every build, the release one too, off until
             the launch or the title bar's plug switches one on, and the plug's lamps showing what is open and what
             is or was connected. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-automation</artifactId>
            <version>${vexelray.framework.version}</version>
        </dependency>
        <!-- The title bar, which the framework hands over and this application places. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>${vexelray.gui.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
            <version>${vexelray.gui.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <!-- The title bar's camera records video as well as taking screenshots: found through ServiceLoader, so this
             dependency is all it takes. AV1 into Matroska, through an FFmpeg that holds the AV1 encoders and no
             decoder (ffmpeg-wrapper-record). -->
        <dependency>
            <groupId>dev.vexelray.codec</groupId>
            <artifactId>vexelray-codec-record</artifactId>
            <version>${vexelray.codec.version}</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  GraalVM native image, shared by -Pnative and -Pnative-release, which differ only in the image's
                  name and its subsystem. The reachability metadata (FFM downcalls and
                  upcalls, reflection, resources) is under src/main/resources/META-INF/native-image/; see the README
                  for how to record it again.
                -->
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>0.10.6</version>
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <id>build-native</id>
                            <goals><goal>compile-no-fork</goal></goals>
                            <phase>package</phase>
                        </execution>
                    </executions>
                    <configuration>
                        <imageName>${native.imageName}</imageName>
                        <mainClass>${app.mainClass}</mainClass>
                        <buildArgs>
                            <!-- The FFM flags, the shaders and the font atlas come from the libraries' own
                                 META-INF/native-image metadata. -->
                            <buildArg>--no-fallback</buildArg>
                            <buildArg>-Dstdout.encoding=UTF-8</buildArg>
                            <!-- WINDOWS = no console window, and /ENTRY:mainCRTStartup is not optional alongside it:
                                 the linker would otherwise look for WinMain, and the image's entry is the C main.
                                 CONSOLE is the linker's default, spelled out so both builds pass the same
                                 options. Windows linker options. -->
                            <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:${native.subsystem}</buildArg>
                            <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>
                            <buildArg>-H:NativeLinkerOption=${project.build.directory}/fluid-sim.res</buildArg>
                        </buildArgs>
                    </configuration>
                </plugin>
                <!-- The executable's icon: a resource linked into the program, so it has to exist as a compiled .res
                     before link time. rc.exe is the Windows SDK's resource compiler and must be on PATH, as it is in a
                     Visual Studio developer prompt (which the native build already needs for link.exe). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                    <executions>
                        <execution>
                            <id>compile-icon-resource</id>
                            <phase>prepare-package</phase>
                            <goals><goal>run</goal></goals>
                            <configuration>
                                <target>
                                    <exec executable="rc.exe" searchpath="true" failonerror="true">
                                        <arg value="/nologo"/>
                                        <arg value="/fo"/>
                                        <arg file="${project.build.directory}/fluid-sim.res"/>
                                        <arg file="${project.basedir}/src/main/rc/fluid-sim.rc"/>
                                    </exec>
                                </target>
                            </configuration>
                        </execution>
                        <!-- The recording encoder (see ffmpeg-record-beside) laid out flat in target/ffmpeg-record, and
                             zipped for installer.json, which unpacks it into the install's own ffmpeg-record folder.
                             Fixed times, so the same libraries make the same zip and an installer that already has
                             its hash skips the download. -->
                        <execution>
                            <id>ffmpeg-record-zip</id>
                            <phase>prepare-package</phase>
                            <goals><goal>run</goal></goals>
                            <configuration>
                                <target>
                                    <delete dir="${project.build.directory}/ffmpeg-record"/>
                                    <copy todir="${project.build.directory}/ffmpeg-record" flatten="true">
                                        <fileset dir="${project.build.directory}/ffmpeg-wrapper-record/natives/record/windows-x86_64"/>
                                    </copy>
                                    <delete file="${project.build.directory}/fluid-sim-ffmpeg-record-windows-x86_64.zip"/>
                                    <zip destfile="${project.build.directory}/fluid-sim-ffmpeg-record-windows-x86_64.zip"
                                         basedir="${project.build.directory}/ffmpeg-record"
                                         modificationtime="2026-01-01T00:00:00Z"/>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!-- The camera's video recording beside the executable. ffmpeg-wrapper-record-windows's encoder (AV1 into
                     Matroska, 14 MB) is not a resource of the image, so it is taken out of its jar (into
                     target/ffmpeg-wrapper-record, then flattened into target/ffmpeg-record by ffmpeg-record-zip), where
                     its loader looks beside an executable run from target/. Without it a native build offers
                     "Record video to file…" and fails when it is clicked. FFmpeg's and SVT-AV1's licences come out
                     with the libraries. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.7.0</version>
                    <executions>
                        <execution>
                            <id>ffmpeg-record-beside</id>
                            <phase>prepare-package</phase>
                            <goals><goal>unpack-dependencies</goal></goals>
                            <configuration>
                                <includeArtifactIds>ffmpeg-wrapper-record-windows</includeArtifactIds>
                                <includes>natives/record/windows-x86_64/**</includes>
                                <outputDirectory>${project.build.directory}/ffmpeg-wrapper-record</outputDirectory>
                                <overWriteReleases>true</overWriteReleases>
                                <overWriteSnapshots>true</overWriteSnapshots>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The framework's annotation processor: it generates FluidDemoWiring from Recipes and Physics,
                         and what its vocabulary calls a compile error is one. Named rather than found, because since
                         JDK 23 javac runs no processor it merely finds on the class path. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>dev.vexelray.framework</groupId>
                            <artifactId>vexelray-framework-processor</artifactId>
                            <version>${vexelray.framework.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!-- Run in a fresh JVM, so native access can be enabled for Panama:  mvn exec:exec
                 One command line split on whitespace, as the template does it, so a multi-word app.args is
                 several arguments. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <commandlineArgs>--enable-native-access=ALL-UNNAMED -Dstdout.encoding=UTF-8 -Dautomation=${automation} "-Dbuild.dir=${project.build.directory}" ${app.jvmArgs} -classpath %classpath ${app.mainClass} ${app.args}</commandlineArgs>
                </configuration>
            </plugin>
            <!-- The bill the About window reads (vexelray-build/README.md). This module is the application, and its
                 installer.json and THIRD-PARTY-NOTICES.txt are the repository's, at the root. -->
            <plugin>
                <groupId>dev.vexelray.build</groupId>
                <artifactId>vexelray-build-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>identify</id>
                        <goals>
                            <goal>identify</goal>
                        </goals>
                        <configuration>
                            <installerConfig>${project.basedir}/../installer.json</installerConfig>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          GraalVM native images, profile-gated as vexelray-gui-demo's are: native-image takes a minute and needs a
          GraalVM JDK, and an ordinary package must not pay for it. Both run rc.exe for the icon (src/main/rc), so run
          them from a Visual Studio developer prompt, which link.exe already asks for.

          mvn -Pnative-release -pl vexelray-sim-fluid-demo -am package  ->  target/fluid-sim.exe
              what ships: a GUI subsystem program; installer.json points at it.
          mvn -Pnative -pl vexelray-sim-fluid-demo -am package          ->  target/vexelray-sim-fluid-demo.exe
              a console program, whose stdout carries the port ottermate reads.
          Both carry the automation sockets, off until asked for, with the title bar's plug showing their state.
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-release</id>
            <properties>
                <native.imageName>fluid-sim</native.imageName>
                <native.subsystem>WINDOWS</native.subsystem>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Exactly one activates from the host OS: VexelRay's provider and tactroller's input backend. -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-macos</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
